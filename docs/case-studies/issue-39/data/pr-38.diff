+        return false;
+    };
+
+    let Some(rest) = first_line.strip_prefix('(') else {
+        return false;
+    };
+
+    let mut tokens = rest
+        .split(|c: char| c.is_whitespace() || c == '(' || c == ')')
+        .filter(|t| !t.is_empty());
+
+    let Some(mut marker) = tokens.next() else {
+        return false;
+    };
